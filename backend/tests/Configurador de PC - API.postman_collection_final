        {
          "name": "Registro",
          "event": [
            {
              "listen": "prerequest",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "// Usuario único por ejecución (eugenio + marca de tiempo) para que el registro no choque.",
                  "var n = 'eugenio_' + Date.now();",
                  "pm.collectionVariables.set('regUser', n);",
                  "pm.collectionVariables.set('regEmail', n + '@correo.com');",
                  "pm.collectionVariables.set('regPass', 'test1234');"
                ]
              }
            },
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Registro correcto (200 o 201)', function () {",
                  "  pm.expect([200, 201]).to.include(pm.response.code);",
                  "});",
                  "pm.test('Respuesta en JSON', function () {",
                  "  pm.response.to.be.json;",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"{{regUser}}\",\n  \"email\": \"{{regEmail}}\",\n  \"password\": \"{{regPass}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/register",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "register"
              ]
            },
            "description": "Registra un usuario nuevo (RF-01 / CU-01). El usuario es único en cada ejecución."
          },
          "response": []
        },
