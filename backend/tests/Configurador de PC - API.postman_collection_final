              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Login responde correctamente (200)', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "var d = pm.response.json();",
                  "pm.test('Devuelve un token', function () {",
                  "  pm.expect(d.token, 'no hay token en la respuesta').to.be.a('string');",
                  "});",
                  "if (d && d.token) { pm.collectionVariables.set('token', d.token); }"
